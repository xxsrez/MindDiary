{
  "$schema": "mind-diary/credential-write-target/v1",
  "version": 1,
  "source": "docs/specs/credential-write-target.md",
  "decision": "docs/decisions/0022-site-controlled-credential-write-target.md",
  "release": "0.3",
  "status": "implemented_repository_candidate_uat_pending",
  "readAuthorization": {
    "explicitMindRequired": true,
    "revisionResolutionRequired": true,
    "clientRevisionSelectorRequired": false,
    "omittedRevision": "resolve_current_head_to_exact_revision",
    "contentReadScopeRequired": true,
    "readBindingRequired": false,
    "crossMindQueryAllowed": false,
    "currentAccessRechecked": true,
    "cases": {
      "personal": {
        "discovery": "trusted_actor_me",
        "requiredAccess": "own_principal"
      },
      "private": {
        "discovery": "membership_only",
        "requiredAccess": "active_membership_read"
      },
      "unlisted_exact_handle": {
        "discovery": "exact_handle_only",
        "requiredAccess": "authenticated_baseline_reader_or_membership"
      },
      "public_catalog": {
        "discovery": "authenticated_catalog_or_exact_handle",
        "requiredAccess": "authenticated_baseline_reader_or_membership"
      },
      "historical": {
        "discovery": "after_current_mind_authorization",
        "requiredAccess": "current_access_not_historical_acl"
      }
    }
  },
  "ownership": {
    "serverDerivedOwnerField": "binding_owner_id",
    "ownerKinds": ["oauth_grant", "personal_token"],
    "ownerImmutable": true,
    "ownerIndependentPerCredential": true,
    "accessRefreshPreservesOwner": true,
    "oauthReconnectCreatesNewOwner": true,
    "personalTokenReissueCreatesNewOwner": true,
    "clientOwnerFieldsAccepted": false
  },
  "targetState": {
    "contractVersion": "credential-write-target/v1",
    "initialTargetVersion": 0,
    "maximumActiveTargets": 1,
    "generationOpaque": true,
    "generationNeverReused": true,
    "authorityCachedInTarget": [],
    "transitions": {
      "select_empty": {
        "versionDelta": 1,
        "generation": "new",
        "previous": "none"
      },
      "switch_other": {
        "versionDelta": 1,
        "generation": "new",
        "previous": "invalidated"
      },
      "select_same": {
        "versionDelta": 0,
        "generation": "preserved",
        "result": "idempotent_no_op"
      },
      "clear": {
        "versionDelta": 1,
        "generation": "none",
        "previous": "invalidated"
      },
      "revoke_or_expire": {
        "versionDelta": 0,
        "generation": "unusable",
        "fallback": "none"
      }
    }
  },
  "siteControl": {
    "mutationSurface": "trusted_sites_web_only",
    "oauthLocation": "connection_detail",
    "personalTokenLocation": "advanced_mcp",
    "actions": ["select_write", "clear_write"],
    "switchSemantics": "select_write_when_target_exists",
    "commonRequires": [
      "sites_principal",
      "credential_owner_authority",
      "actor_owned_presentation_ref",
      "expected_target_version",
      "idempotency_key",
      "server_read_back"
    ],
    "requirementsByAction": {
      "select_write": {
        "mindRefRequired": true,
        "requires": [
          "active_lifecycle",
          "content_write_scope",
          "current_writer_role",
          "target_eligibility"
        ]
      },
      "clear_write": {
        "mindRefRequired": false,
        "requires": ["active_lifecycle"],
        "forbiddenRequirements": [
          "target_acl",
          "current_writer_role",
          "target_eligibility"
        ],
        "allowedAfter": [
          "target_acl_loss",
          "target_role_loss",
          "target_deletion"
        ],
        "targetMetadataDisclosure": false,
        "authorityEffect": "reduce_only"
      }
    },
    "versionConflict": {
      "condition": "stale_expected_target_version",
      "code": "target_conflict",
      "httpStatus": 409,
      "stateChange": false,
      "targetMetadataDisclosure": false,
      "lastWriteWins": false,
      "owner": "MD-337"
    },
    "forbiddenBrowserAuthorityFields": [
      "binding_owner_id",
      "credential_id",
      "principal_id",
      "space_id",
      "role"
    ],
    "readableProjectionPersistedAsBinding": false
  },
  "mcp": {
    "targetInspection": false,
    "targetInspectionSurface": "trusted_sites_web_only",
    "targetMutation": false,
    "exportAuthority": "absent",
    "removedTargetTools": [
      "get_mind_bindings",
      "set_read_mind_binding",
      "set_write_mind_binding"
    ],
    "removedAdministrativeExportTools": [
      "start_export",
      "get_export_status"
    ],
    "exportDispositionOwnedBy": "MD-337",
    "exportRoutesAndProjectionOwnedBy": "MD-359",
    "capabilityTargetField": "requires_writable_target",
    "canonicalTargetErrors": [
      "writable_target_required",
      "writable_target_mismatch",
      "writable_target_unavailable"
    ],
    "protocolProfilesShareSemantics": true,
    "operationNamesOwnedBy": "MD-337"
  },
  "commit": {
    "requiredInputFields": [
      "mind",
      "expected_revision",
      "idempotency_key",
      "operations"
    ],
    "forbiddenAuthorityInputFields": [
      "binding_owner_id",
      "principal_id",
      "space_id",
      "role",
      "scope",
      "target_version",
      "write_target_generation",
      "write_binding_id",
      "expected_binding_version"
    ],
    "transactionChecks": [
      "active_credential",
      "exact_immutable_owner",
      "content_write_scope",
      "server_pins_active_target_generation",
      "explicit_mind_matches_generation",
      "current_writer_role",
      "transaction_rechecks_same_generation",
      "staged_refs_same_owner_generation",
      "expected_head",
      "validation_and_quotas",
      "idempotency"
    ],
    "idempotencyNamespace": [
      "binding_owner_id",
      "target_generation",
      "space_id",
      "operation",
      "key"
    ],
    "fallback": "none"
  },
  "failureMatrix": [
    {
      "case": "missing_target",
      "code": "writable_target_required",
      "reachableObject": false,
      "revision": false,
      "headMove": false,
      "auditOrOutbox": false,
      "indexEffect": false,
      "stagedConsumption": false,
      "fallback": "none"
    },
    {
      "case": "legacy_owner_pending_upgrade",
      "code": "writable_target_required",
      "reachableObject": false,
      "revision": false,
      "headMove": false,
      "auditOrOutbox": false,
      "indexEffect": false,
      "stagedConsumption": false,
      "fallback": "none"
    },
    {
      "case": "stale_generation",
      "code": "writable_target_unavailable",
      "reachableObject": false,
      "revision": false,
      "headMove": false,
      "auditOrOutbox": false,
      "indexEffect": false,
      "stagedConsumption": false,
      "fallback": "none"
    },
    {
      "case": "wrong_mind",
      "code": "writable_target_mismatch",
      "reachableObject": false,
      "revision": false,
      "headMove": false,
      "auditOrOutbox": false,
      "indexEffect": false,
      "stagedConsumption": false,
      "fallback": "none"
    },
    {
      "case": "revoked_or_expired_owner",
      "code": "writable_target_unavailable",
      "reachableObject": false,
      "revision": false,
      "headMove": false,
      "auditOrOutbox": false,
      "indexEffect": false,
      "stagedConsumption": false,
      "fallback": "none"
    },
    {
      "case": "scope_loss",
      "code": "insufficient_scope",
      "reachableObject": false,
      "revision": false,
      "headMove": false,
      "auditOrOutbox": false,
      "indexEffect": false,
      "stagedConsumption": false,
      "fallback": "none"
    },
    {
      "case": "role_loss",
      "code": "forbidden",
      "reachableObject": false,
      "revision": false,
      "headMove": false,
      "auditOrOutbox": false,
      "indexEffect": false,
      "stagedConsumption": false,
      "fallback": "none"
    },
    {
      "case": "visibility_removes_read_grant",
      "code": "mind_not_found",
      "reachableObject": false,
      "revision": false,
      "headMove": false,
      "auditOrOutbox": false,
      "indexEffect": false,
      "stagedConsumption": false,
      "fallback": "none"
    },
    {
      "case": "corrupt_or_partial_state",
      "code": "writable_target_unavailable",
      "reachableObject": false,
      "revision": false,
      "headMove": false,
      "auditOrOutbox": false,
      "indexEffect": false,
      "stagedConsumption": false,
      "fallback": "none"
    },
    {
      "case": "stale_head",
      "code": "revision_conflict",
      "reachableObject": false,
      "revision": false,
      "headMove": false,
      "auditOrOutbox": false,
      "indexEffect": false,
      "stagedConsumption": false,
      "fallback": "none"
    }
  ],
  "migration": {
    "capability": "credential-write-target/v1",
    "legacyInitialLifecycle": "pending_upgrade",
    "legacyReadBindings": "not_authority_and_not_migrated",
    "contentReadCompatibility": {
      "freshOrUpgradedAuthority": "current_acl_or_visibility",
      "legacyProfileOutcome": "fail_closed_before_acl_discovery_or_read",
      "code": "credential_access_upgrade_required",
      "schema": "mind-diary/credential-access-upgrade-required/v1",
      "retryable": false,
      "remediation": ["upgrade", "re-consent", "reissue"],
      "mindMetadataDisclosed": false,
      "readBindingAuthority": false
    },
    "legacyWriteIdsAcceptedByV1": false,
    "legacyStagedRefsAcceptedByV1": false,
    "unknownAttemptResumed": false,
    "completedImmutableResultPreserved": true,
    "oauth": {
      "explicitAction": "same_grant_reconsent",
      "sameOwnerRequired": true,
      "preserveOnly": "exactly_one_unambiguous_active_target",
      "requiredChecks": [
        "active_same_grant_owner",
        "one_active_legacy_write_record",
        "no_contradictory_generation",
        "one_active_resolved_mind",
        "content_write_scope",
        "current_writer_role",
        "atomic_new_v1_generation"
      ],
      "oldGenerationReused": false,
      "failedCheckOutcome": "active_v1_owner_empty_target"
    },
    "personalToken": {
      "explicitAction": "reissue_required",
      "inPlaceWriteUpgrade": false,
      "newOwner": true,
      "newTarget": "empty",
      "legacyReadMayContinueUntilLifecycleEnd": false,
      "legacyWriteOutcome": "writable_target_required",
      "legacyWriteRemediationState": "pending_upgrade_reissue_required"
    },
    "reconnect": {
      "newOwner": true,
      "newTarget": "empty",
      "targetCopyAllowed": false
    },
    "ambiguousCorruptOrPartialOutcome": "empty_or_unavailable_never_guessed"
  },
  "captureAndStaging": {
    "captureDefault": "disabled",
    "capturePin": ["binding_owner_id", "target_generation"],
    "captureEnableSurface": "trusted_sites_web_only",
    "captureTransferAcrossGeneration": false,
    "captureTransferAcrossOwner": false,
    "captureMigrationPreserveRequiresSeparateConfirmation": true,
    "captureTransactionRechecks": [
      "owner",
      "generation",
      "content_write_scope",
      "current_writer_role",
      "private_visibility",
      "expected_head"
    ],
    "newStagedRefPin": ["binding_owner_id", "target_generation"],
    "legacyStagedRefRemap": false
  },
  "legacyCompatibility": {
    "historicalContractRetained": true,
    "historicalEvidenceReclassifiedAsTarget": false,
    "silentOldIdTranslation": false,
    "silentPersonalFallback": false,
    "wireAliasDispositionOwnedBy": "MD-337",
    "retiredTargetErrorAliases": [
      "write_binding_required",
      "write_binding_stale",
      "binding_owner_revoked",
      "binding_state_unavailable",
      "write_target_required",
      "write_target_upgrade_required",
