      "disposition": "keep",
      "profile": "web-import",
      "mindScope": "session-pinned",
      "owner": "none"
    },
    {
      "key": "PUT /api/v1/markdown-imports/{import_id}/batches/{checkpoint}",
      "disposition": "keep",
      "profile": "web-import",
      "mindScope": "session-pinned",
      "owner": "none"
    },
    {
      "key": "POST /api/v1/markdown-imports/{import_id}/validate",
      "disposition": "keep",
      "profile": "web-import",
      "mindScope": "session-pinned",
      "owner": "none"
    },
    {
      "key": "POST /api/v1/markdown-imports/{import_id}/commit",
      "disposition": "keep",
