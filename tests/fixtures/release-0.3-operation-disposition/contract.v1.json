{
  "$schema": "mind-diary/release-0.3-operation-disposition/v1",
  "version": 1,
  "source": "docs/specs/release-0.3-operation-disposition.md",
  "authority": {
    "sitesControl": [
      "account",
      "mind_metadata",
      "mind_usage",
      "visibility",
      "membership",
      "ownership",
      "connections",
      "credentials",
      "bulk_import",
      "bulk_export",
      "administrative_deletion"
    ],
    "contentMcp": [
      "discovery",
      "browse",
      "search",
      "fetch",
      "history",
      "standalone_validation",
      "per_file_ingress",
      "exact_target_content_commit"
    ],
    "implicitPersonalMindFallback": false,
    "implicitCrossMind": false,
    "readBindingRequired": false,
    "writableMindSelectedOn": "principal_mind_usage_on_sites"
  },
  "profiles": {
    "web-session": {
      "target": "sites-control",
      "actor": "platform-authenticated-identity",
      "checks": [
        "sites_identity_resolution",
        "safe_session_projection"
      ],
      "errors": [
        "authentication_required",
        "identity_binding_unavailable"
      ],
      "compatibility": "keep-route"
    },
    "web-bootstrap": {
      "target": "sites-control",
      "actor": "platform-authenticated-unregistered-identity",
      "checks": [
        "sites_identity",
        "external_binding_resolution",
        "idempotent_isolated_bootstrap"
      ],
      "errors": [
        "identity_binding_unavailable",
        "bootstrap_conflict"
      ],
      "compatibility": "keep-route"
    },
    "web-read": {
      "target": "sites-control",
      "actor": "registered-sites-principal",
      "checks": [
        "sites_identity",
        "current_acl_or_visibility",
        "authorize_before_metadata"
      ],
      "errors": [
        "authentication_required",
        "indistinguishable_not_found"
      ],
      "compatibility": "keep-route"
    },
    "web-write": {
      "target": "sites-control",
      "actor": "registered-sites-principal",
      "checks": [
        "sites_identity",
        "same_origin",
        "csrf",
        "current_named_capability",
        "idempotency_or_cas"
      ],
      "errors": [
        "invalid_request",
        "forbidden",
        "conflict"
      ],
      "compatibility": "keep-route"
    },
    "web-import": {
      "target": "sites-control",
      "actor": "registered-sites-principal",
      "checks": [
        "current_content_write",
        "quota_reservation",
        "session_owner",
        "base_revision",
        "head_cas"
      ],
      "errors": [
        "import_validation_failed",
        "capacity_limit",
        "import_conflict"
      ],
      "compatibility": "keep-route"
    },
    "web-export": {
      "target": "sites-control",
      "actor": "registered-sites-principal",
      "checks": [
        "sites_identity",
        "current_read_access",
        "exact_revision",
        "explicit_mixed_profile",
        "creator_private_status",
        "idempotency",
        "quota_reservation",
        "download_reauthorization"
      ],
      "errors": [
        "export_profile_required",
        "export_job_not_found",
        "capacity_limit",
        "conflict"
      ],
      "compatibility": "keep-route"
    },
    "mind-usage-control": {
      "target": "sites-control",
      "actor": "registered-sites-principal",
      "checks": [
        "sites_identity",
        "principal_owned_settings",
        "current_acl",
        "usage_version_cas",
        "singleton_read_write",
        "idempotency"
      ],
      "errors": [
        "mind_not_found",
        "read_access_required",
        "writer_access_required",
        "description_required",
        "usage_version_conflict"
      ],
      "compatibility": "principal-wide-not-credential-scoped"
    },
    "operator-read": {
      "target": "sites-control",
      "actor": "constructor-allowlisted-service-operator",
      "checks": [
        "sites_identity",
        "service_operator_allowlist",
        "privacy_safe_projection"
      ],
      "errors": [
        "indistinguishable_not_found"
      ],
      "compatibility": "keep-route"
    },
    "content-read": {
      "target": "content-mcp",
      "actor": "oauth-or-personal-token-principal",
      "checks": [
        "content_read_scope",
        "principal_usage_read_or_read_write",
        "explicit_mind_when_targeted",
        "current_acl_or_visibility",
        "exact_revision_when_selected"
      ],
      "errors": [
        "authentication_required",
        "credential_access_upgrade_required",
        "forbidden_or_not_found",
        "invalid_mind_selector",
        "invalid_revision_selector"
      ],
      "compatibility": "same-name-principal-usage-profile"
    },
    "content-write": {
      "target": "content-mcp",
      "actor": "oauth-or-personal-token-principal",
      "checks": [
        "content_write_scope",
        "exact_principal_read_write_mind",
        "principal_mount_generation",
        "current_acl",
        "authorized_routing_profile",
        "source_reference_access",
        "idempotency",
        "head_cas"
      ],
      "errors": [
        "writable_mind_required",
        "writable_mind_stale",
        "revision_conflict",
        "idempotency_conflict",
        "source_reference_invalid"
      ],
      "compatibility": "same-name-principal-mount-schema"
    },
    "content-ingress": {
      "target": "content-mcp",
      "actor": "oauth-or-personal-token-principal",
      "checks": [
        "content_write_scope",
        "exact_principal_read_write_mind",
        "principal_mount_generation",
        "source_owner",
        "size",
        "sha256",
        "quota",
        "expiry"
      ],
      "errors": [
        "writable_mind_required",
        "writable_mind_stale",
        "file_ingress_source_unavailable",
        "file_ingress_intent_conflict",
        "capacity_limit"
      ],
      "compatibility": "same-name-principal-mount-schema"
    },
    "mcp-transport": {
      "target": "content-mcp",
      "actor": "oauth-or-personal-token-principal",
      "checks": [
        "bearer_every_post",
        "exact_resource",
        "protocol_envelope",
        "per_method_or_tool_scope",
        "current_access"
      ],
      "errors": [
        "oauth_challenge",
        "protocol_error",
        "tool_error"
      ],
      "compatibility": "profile-specific-lifecycle"
    },
    "capability-ingress": {
      "target": "content-delivery",
      "actor": "one-use-capability",
      "checks": [
        "same_origin_capability",
        "target_pin",
        "size",
        "sha256",
        "quota",
        "expiry"
      ],
      "errors": [
        "not_found",
        "gone",
        "conflict",
        "invalid_request"
      ],
      "compatibility": "keep-route-new-target-pin"
    },
    "oauth": {
      "target": "oauth-adapter",
      "actor": "public-client-or-sites-principal",
      "checks": [
        "pkce",
        "exact_redirect",
        "exact_resource",
        "trusted_sites_identity",
        "grant_lifecycle"
      ],
      "errors": [
        "oauth_protocol_error"
      ],
      "compatibility": "keep-route"
    },
    "delivery-grant": {
      "target": "content-delivery",
      "actor": "one-use-opaque-grant",
      "checks": [
        "grant_verifier",
        "captured_principal",
        "captured_mind_revision",
        "current_read_access",
        "one_use"
      ],
      "errors": [
        "indistinguishable_not_found"
      ],
      "compatibility": "keep-or-move-issuer"
    },
    "compat-removed": {
      "target": "none",
      "actor": "none",
      "checks": [],
      "errors": [
        "operation_retired_from_content_mcp"
      ],
      "compatibility": "omit-schema-and-return-versioned-retired-result-for-exact-cached-binding-or-capture-name"
    },
    "personal-configuration": {
      "target": "content-mcp",
      "actor": "authenticated-current-principal",
      "checks": [
        "personal_configure_scope",
        "own_personal_binding",
        "current_credential",
        "metadata_cas",
        "idempotency"
      ],
      "errors": [
        "insufficient_scope",
        "metadata_conflict",
        "idempotency_conflict"
      ],
      "compatibility": "modern-compat-parity"
    }
  },
  "credentialAccessCompatibility": {
    "appliesBefore": [
      "acl_discovery",
      "mind_metadata",
      "canonical_object",
      "derived_index"
    ],
    "freshOrUpgradedAuthority": "current_acl_or_visibility",
    "legacyProfileOutcome": "fail_closed",
    "code": "credential_access_upgrade_required",
    "schema": "mind-diary/credential-access-upgrade-required/v1",
    "retryable": false,
    "remediation": [
      "upgrade",
      "re-consent",
      "reissue"
    ],
    "mindMetadataDisclosed": false,
    "readBindingAuthority": false
  },
  "principalMindUsage": {
    "disposition": "change",
    "implementationOwner": "MD-374",
    "runtimeStatus": "principal-usage-implemented",
    "appliesTo": [
      "GET /api/v1/mind-usage",
      "GET /api/v1/minds/{mind_ref}/usage",
      "PUT /api/v1/minds/{mind_ref}/usage"
    ],
    "implementedRuntime": {
      "inputVersionField": "expected_usage_version",
      "modeEnum": [
        "disabled",
        "read",
        "read_write"
      ],
      "scope": "principal",
      "singleWritable": true,
      "staleExpectedVersion": {
        "httpStatus": 409,
        "code": "usage_version_conflict",
        "stateChange": "none",
        "metadataDisclosure": "none"
      }
    },
    "read": {
      "checks": [
        "current_read_access",
        "expected_usage_version",
        "idempotency"
      ],
      "errors": [
        "mind_not_found",
        "read_access_required",
        "usage_version_conflict"
      ],
      "metadataDisclosure": "authorized-mind-only"
    },
    "read_write": {
      "checks": [
        "current_read_access",
        "current_writer_role",
        "authorized_routing_profile",
        "expected_usage_version",
        "idempotency"
      ],
      "errors": [
        "mind_not_found",
        "writer_access_required",
        "description_required",
        "usage_version_conflict"
      ],
      "metadataDisclosure": "authorized-mind-only"
    }
  },
  "restRoutes": [
    {
      "key": "GET /api/v1/session",
      "disposition": "keep",
      "profile": "web-session",
      "mindScope": "none",
      "owner": "none"
    },
    {
      "key": "POST /api/v1/account",
      "disposition": "keep",
      "profile": "web-bootstrap",
      "mindScope": "personal-bootstrap",
      "owner": "none"
    },
    {
      "key": "PATCH /api/v1/account",
      "disposition": "keep",
      "profile": "web-write",
      "mindScope": "personal-metadata",
      "owner": "none"
    },
    {
      "key": "GET /api/v1/account/deletion-impact",
      "disposition": "keep",
      "profile": "web-read",
      "mindScope": "account-cascade",
      "owner": "none"
    },
    {
      "key": "DELETE /api/v1/account",
      "disposition": "keep",
      "profile": "web-write",
      "mindScope": "account-cascade",
      "owner": "none"
    },
    {
      "key": "GET /api/v1/minds",
      "disposition": "keep",
      "profile": "web-read",
      "mindScope": "current-access-metadata",
      "owner": "none"
    },
    {
      "key": "GET /api/v1/mind-usage",
      "disposition": "change",
      "profile": "mind-usage-control",
      "mindScope": "principal-enabled-singleton",
      "owner": "MD-374"
    },
    {
      "key": "POST /api/v1/minds",
      "disposition": "keep",
      "profile": "web-write",
      "mindScope": "new-ordinary",
      "owner": "none"
    },
    {
      "key": "GET /api/v1/minds/{mind_ref}",
      "disposition": "keep",
      "profile": "web-read",
      "mindScope": "explicit-current-metadata",
      "owner": "none"
    },
    {
      "key": "GET /api/v1/minds/{mind_ref}/usage",
      "disposition": "change",
      "profile": "mind-usage-control",
      "mindScope": "explicit-current-usage",
      "owner": "MD-374"
    },
    {
      "key": "PUT /api/v1/minds/{mind_ref}/usage",
      "disposition": "change",
      "profile": "mind-usage-control",
      "mindScope": "explicit-current-usage",
      "owner": "MD-374"
    },
    {
      "key": "GET /api/v1/minds/{mind_ref}/capacity",
      "disposition": "keep",
      "profile": "web-read",
      "mindScope": "explicit-current-capacity",
      "owner": "none"
    },
    {
      "key": "POST /api/v1/minds/{mind_ref}/exports",
      "disposition": "keep",
      "profile": "web-export",
      "mindScope": "explicit-exact-revision",
      "owner": "MD-361"
    },
    {
      "key": "GET /api/v1/export-jobs/{job_id}",
      "disposition": "keep",
      "profile": "web-export",
      "mindScope": "creator-private-job-pinned-revision",
      "owner": "MD-361"
    },
    {
      "key": "POST /api/v1/minds/{mind_ref}/markdown-import-plans",
      "disposition": "keep",
      "profile": "web-import",
      "mindScope": "explicit-base-revision",
      "owner": "none"
    },
    {
      "key": "POST /api/v1/minds/{mind_ref}/markdown-imports",
      "disposition": "keep",
      "profile": "web-import",
      "mindScope": "explicit-base-revision",
      "owner": "none"
    },
    {
