  "profiles": {
    "web-session": {
      "target": "sites-control",
      "actor": "platform-authenticated-identity",
      "checks": ["sites_identity_resolution", "safe_session_projection"],
      "errors": ["authentication_required", "identity_binding_unavailable"],
      "compatibility": "keep-route"
    },
    "web-bootstrap": {
      "target": "sites-control",
      "actor": "platform-authenticated-unregistered-identity",
      "checks": ["sites_identity", "external_binding_resolution", "idempotent_isolated_bootstrap"],
      "errors": ["identity_binding_unavailable", "bootstrap_conflict"],
      "compatibility": "keep-route"
    },
    "web-read": {
      "target": "sites-control",
      "actor": "registered-sites-principal",
      "checks": ["sites_identity", "current_acl_or_visibility", "authorize_before_metadata"],
      "errors": ["authentication_required", "indistinguishable_not_found"],
      "compatibility": "keep-route"
    },
    "web-write": {
      "target": "sites-control",
      "actor": "registered-sites-principal",
      "checks": ["sites_identity", "same_origin", "csrf", "current_named_capability", "idempotency_or_cas"],
      "errors": ["invalid_request", "forbidden", "conflict"],
      "compatibility": "keep-route"
    },
    "web-import": {
      "target": "sites-control",
      "actor": "registered-sites-principal",
      "checks": ["current_content_write", "quota_reservation", "session_owner", "base_revision", "head_cas"],
      "errors": ["import_validation_failed", "capacity_limit", "import_conflict"],
      "compatibility": "keep-route"
    },
    "web-export": {
      "target": "sites-control",
      "actor": "registered-sites-principal",
      "checks": ["sites_identity", "current_read_access", "exact_revision", "explicit_mixed_profile", "creator_private_status", "idempotency", "quota_reservation", "download_reauthorization"],
      "errors": ["export_profile_required", "export_job_not_found", "capacity_limit", "conflict"],
      "compatibility": "keep-route"
    },
    "credential-control": {
      "target": "sites-control",
      "actor": "credential-owner-sites-principal",
      "checks": ["credential_owner_authority", "target_version_cas", "idempotency"],
      "errors": ["credential_not_found", "operation_removed", "write_step_up_required", "target_conflict"],
      "compatibility": "reject-old-read-actions"
    },
    "operator-read": {
      "target": "sites-control",
      "actor": "constructor-allowlisted-service-operator",
      "checks": ["sites_identity", "service_operator_allowlist", "privacy_safe_projection"],
      "errors": ["indistinguishable_not_found"],
      "compatibility": "keep-route"
    },
    "content-read": {
      "target": "content-mcp",
      "actor": "oauth-or-personal-token-principal",
      "checks": ["content_read_scope", "explicit_mind_when_targeted", "current_acl_or_visibility", "exact_revision_when_selected"],
      "errors": ["authentication_required", "forbidden_or_not_found", "invalid_mind_selector", "invalid_revision_selector"],
      "compatibility": "same-name-no-read-binding"
    },
    "content-write": {
      "target": "content-mcp",
      "actor": "oauth-or-personal-token-principal",
      "checks": ["content_write_scope", "explicit_mind", "site_selected_target_match", "current_acl", "idempotency", "head_cas"],
      "errors": ["writable_target_required", "writable_target_mismatch", "writable_target_unavailable", "revision_conflict", "idempotency_conflict"],
      "compatibility": "same-name-new-target-schema"
    },
    "content-ingress": {
      "target": "content-mcp",
      "actor": "oauth-or-personal-token-principal",
      "checks": ["content_write_scope", "site_selected_target_match", "source_owner", "size", "sha256", "quota", "expiry"],
      "errors": ["writable_target_required", "writable_target_mismatch", "file_ingress_source_unavailable", "file_ingress_intent_conflict", "capacity_limit"],
      "compatibility": "same-name-new-target-schema"
    },
    "mcp-transport": {
      "target": "content-mcp",
      "actor": "oauth-or-personal-token-principal",
      "checks": ["bearer_every_post", "exact_resource", "protocol_envelope", "per_method_or_tool_scope", "current_access"],
      "errors": ["oauth_challenge", "protocol_error", "tool_error"],
      "compatibility": "profile-specific-lifecycle"
    },
    "capability-ingress": {
      "target": "content-delivery",
      "actor": "one-use-capability",
      "checks": ["same_origin_capability", "target_pin", "size", "sha256", "quota", "expiry"],
      "errors": ["not_found", "gone", "conflict", "invalid_request"],
      "compatibility": "keep-route-new-target-pin"
    },
    "oauth": {
      "target": "oauth-adapter",
      "actor": "public-client-or-sites-principal",
      "checks": ["pkce", "exact_redirect", "exact_resource", "trusted_sites_identity", "grant_lifecycle"],
      "errors": ["oauth_protocol_error"],
      "compatibility": "keep-route"
    },
    "delivery-grant": {
      "target": "content-delivery",
      "actor": "one-use-opaque-grant",
      "checks": ["grant_verifier", "captured_principal", "captured_mind_revision", "current_read_access", "one_use"],
      "errors": ["indistinguishable_not_found"],
      "compatibility": "keep-or-move-issuer"
    },
    "compat-removed": {
      "target": "none",
      "actor": "none",
      "checks": [],
      "errors": ["invalid_params_or_method_not_found"],
      "compatibility": "omit-and-reject"
    }
  },
