{
  "$schema": "mind-diary/principal-mind-usage/v2",
  "version": 2,
  "source": "docs/specs/mind-usage-modes.md",
  "decision": "docs/decisions/0025-personal-mind-description-routing.md",
  "ownership": "principal",
  "defaultMode": "disabled",
  "modes": [
    "disabled",
    "read",
    "read_write"
  ],
  "cardinality": {
    "read": "0..N",
    "ordinary_read_write": "0..1",
    "personal_read_write": "0..1",
    "combined_read_write": "0..2"
  },
  "switchBehavior": "demote_previous_ordinary_read_write_to_read_atomically",
  "writeLanes": {
    "independent": true,
    "ordinary": "automatic_save",
    "personal": "description_or_direct_request"
  },
  "sharedAcrossCredentials": [
    "oauth_grant",
    "personal_token"
  ],
  "effectiveCapabilityChecks": [
    "active_credential",
    "credential_scope",
    "current_acl_or_visibility",
    "current_writer_role"
  ],
  "description": {
    "appliesTo": [
      "ordinary_mind",
      "personal_mind"
    ],
    "absentFrom": [],
    "modelVisible": true,
    "trustedInstruction": false,
    "requiredFor": [
      "ordinary_read_write"
    ],
    "routes": [
      "read",
      "write"
    ]
  },
  "agentRouting": {
    "profiles": {
      "description_based": {
        "appliesTo": "ordinary_mind",
        "readTriggers": [
          "explicit_user_request",
          "description_match"
        ],
        "writeTriggers": [
          "description_match_after_explicit_discussion"
        ],
        "automaticSave": true
      },
      "personal_default": {
        "appliesTo": "personal_mind",
        "readTriggers": [
          "explicit_user_request",
          "nonempty_description_match"
        ],
        "writeTriggers": [
          "explicit_personal_write_request",
          "nonempty_description_match_after_explicit_discussion"
        ],
        "automaticSave": true
      }
    },
    "explicitRequestBypasses": [
      "description_match"
    ],
    "explicitRequestDoesNotBypass": [
      "usage_mode",
      "credential_scope",
      "current_access"
    ],
    "personalWriteRequestExamples": [
      "save",
      "remember",
      "add",
      "update",
      "delete"
    ],
    "personalWriteNonTriggers": [
      "topic_match",
      "discussion_only",
      "read_request",
      "prior_request"
    ],
    "trustedClientIntentFlag": false,
    "crossMindSearch": false,
    "implicitPersonalMindFallback": false
  },
  "automaticSave": {
    "enabledBy": "effective_read_write_and_nonempty_description",
    "routingProfile": "either_profile",
    "excludedRoutingProfiles": [],
    "separateToggle": false,
    "perWriteConfirmation": false,
    "requiresUserNotification": true,
    "requiresExplicitDiscussion": true,
    "backgroundVacuum": false,
    "privateKnowledgeAllowedAfterExplicitDiscussion": true,
    "operations": [
      "create_file",
      "replace_file",
      "delete_file",
      "no_op"
    ],
    "canonicalTool": "commit_changeset",
    "retiredTargetTool": "capture_knowledge",
    "crossMindProvenance": [
      "source_mind",
      "source_revision",
      "source_locator"
    ]
  },
  "evaluationCases": [
    {
      "id": "personal-read-write-null-description",
      "mindType": "personal_mind",
      "mode": "read_write",
      "description": null,
      "trigger": "mode_change",
      "outcome": "allow"
    },
    {
      "id": "personal-discussion-only-write",
      "mindType": "personal_mind",
      "mode": "read_write",
      "description": null,
      "trigger": "discussion_only",
      "outcome": "no_write"
    },
    {
      "id": "personal-explicit-requested-write",
      "mindType": "personal_mind",
      "mode": "read_write",
      "description": null,
      "trigger": "explicit_personal_write_request",
      "outcome": "allow_write"
    },
    {
      "id": "personal-and-ordinary-concurrent-write",
      "mindType": "personal_mind",
      "mode": "read_write",
      "description": null,
      "trigger": "ordinary_read_write_already_enabled",
      "outcome": "allow_both"
    },
    {
      "id": "ordinary-read-write-null-description",
      "mindType": "ordinary_mind",
      "mode": "read_write",
      "description": null,
      "trigger": "mode_change",
      "outcome": "description_required"
    },
    {
      "id": "ordinary-discussed-description-match-write",
      "mindType": "ordinary_mind",
      "mode": "read_write",
      "description": "matching category",
      "trigger": "description_match_after_explicit_discussion",
      "outcome": "allow_write"
    }
  ],
  "okf": {
    "version": "0.2",
    "validateBeforeCommit": "full_bundle",
    "validateAfterCommit": "full_exact_revision",
    "atomicFiles": [
      "concepts",
      "index",
      "log"
    ],
    "preserveUnknownTypesAndFields": true
  },
  "retiredControls": [
    "get_mind_bindings",
    "set_read_mind_binding",
    "set_write_mind_binding",
    "credential_writable_target",
    "capture_toggle"
  ],
  "migration": {
    "capability": "principal-mind-usage/v2",
    "ambiguousOutcome": "disabled",
    "legacyWriteRefsRemapped": false,
    "mixedRuntimeSemantics": false
  }
}
