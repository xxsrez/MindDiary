{
  "$schema": "mind-diary/principal-mind-usage/v1",
  "version": 1,
  "source": "docs/specs/mind-usage-modes.md",
  "decision": "docs/decisions/0024-principal-mind-usage-modes-and-automatic-save.md",
  "ownership": "principal",
  "defaultMode": "disabled",
  "modes": ["disabled", "read", "read_write"],
  "cardinality": {
    "read": "0..N",
    "read_write": "0..1"
  },
  "switchBehavior": "demote_previous_read_write_to_read_atomically",
  "sharedAcrossCredentials": ["oauth_grant", "personal_token"],
  "effectiveCapabilityChecks": [
    "active_credential",
    "credential_scope",
    "current_acl_or_visibility",
    "current_writer_role"
  ],
  "description": {
    "appliesTo": ["ordinary_mind"],
    "absentFrom": ["personal_mind"],
    "modelVisible": true,
    "trustedInstruction": false,
    "requiredFor": ["ordinary_read_write"],
    "routes": ["read", "write"]
  },
  "agentRouting": {
    "profiles": {
      "description_based": {
        "appliesTo": "ordinary_mind",
        "readTriggers": ["explicit_user_request", "description_match"],
        "writeTriggers": ["description_match_after_explicit_discussion"],
        "automaticSave": true
      },
      "personal_default": {
        "appliesTo": "personal_mind",
        "readTriggers": ["explicit_user_request"],
        "writeTriggers": ["explicit_personal_write_request"],
        "automaticSave": false
      }
    },
    "explicitRequestBypasses": ["description_match"],
    "explicitRequestDoesNotBypass": ["usage_mode", "credential_scope", "current_access"],
    "personalWriteRequestExamples": ["save", "remember", "add", "update", "delete"],
    "personalWriteNonTriggers": ["topic_match", "discussion_only", "read_request", "prior_request"],
    "trustedClientIntentFlag": false,
    "crossMindSearch": false,
    "implicitPersonalMindFallback": false
  },
  "automaticSave": {
    "enabledBy": "ordinary_mind_read_write",
    "routingProfile": "description_based",
    "excludedRoutingProfiles": ["personal_default"],
    "separateToggle": false,
    "perWriteConfirmation": false,
    "requiresUserNotification": true,
    "requiresExplicitDiscussion": true,
    "backgroundVacuum": false,
    "privateKnowledgeAllowedAfterExplicitDiscussion": true,
    "operations": ["create_file", "replace_file", "delete_file", "no_op"],
    "canonicalTool": "commit_changeset",
    "retiredTargetTool": "capture_knowledge",
    "crossMindProvenance": ["source_mind", "source_revision", "source_locator"]
  },
  "evaluationCases": [
    {"id":"personal-read-write-null-description","mindType":"personal_mind","mode":"read_write","description":null,"trigger":"mode_change","outcome":"allow"},
    {"id":"personal-discussion-only-write","mindType":"personal_mind","mode":"read_write","description":null,"trigger":"discussion_only","outcome":"no_write"},
    {"id":"personal-explicit-requested-write","mindType":"personal_mind","mode":"read_write","description":null,"trigger":"explicit_personal_write_request","outcome":"allow_write"},
    {"id":"ordinary-read-write-null-description","mindType":"ordinary_mind","mode":"read_write","description":null,"trigger":"mode_change","outcome":"description_required"},
    {"id":"ordinary-discussed-description-match-write","mindType":"ordinary_mind","mode":"read_write","description":"matching category","trigger":"description_match_after_explicit_discussion","outcome":"allow_write"}
  ],
  "okf": {
    "version": "0.2",
    "validateBeforeCommit": "full_bundle",
    "validateAfterCommit": "full_exact_revision",
    "atomicFiles": ["concepts", "index", "log"],
    "preserveUnknownTypesAndFields": true
  },
  "retiredControls": [
    "get_mind_bindings",
    "set_read_mind_binding",
    "set_write_mind_binding",
    "credential_writable_target",
    "capture_toggle"
  ],
  "migration": {
    "capability": "principal-mind-usage/v1",
    "ambiguousOutcome": "disabled",
    "legacyWriteRefsRemapped": false,
    "mixedRuntimeSemantics": false
  }
}
