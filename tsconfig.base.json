{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@mind-diary/domain": ["packages/domain/src/index.ts"],
      "@mind-diary/okf-codec": ["packages/okf-codec/src/index.ts"],
      "@mind-diary/application-contracts": ["packages/application-contracts/src/index.ts"],
      "@mind-diary/application-ports": ["packages/application-ports/src/index.ts"],
      "@mind-diary/application-control": ["packages/application-control/src/index.ts"],
      "@mind-diary/application-content": ["packages/application-content/src/index.ts"],
      "@mind-diary/application-background": ["packages/application-background/src/index.ts"],
      "@mind-diary/adapter-web": ["packages/adapter-web/src/index.ts"],
      "@mind-diary/adapter-mcp": ["packages/adapter-mcp/src/index.ts"],
      "@mind-diary/adapter-oauth-sites": ["packages/adapter-oauth-sites/src/index.ts"],
      "@mind-diary/adapter-background": ["packages/adapter-background/src/index.ts"],
      "@mind-diary/adapter-metadata-memory": ["packages/adapter-metadata-memory/src/index.ts"],
      "@mind-diary/adapter-object-memory": ["packages/adapter-object-memory/src/index.ts"],
      "@mind-diary/adapter-search-memory": ["packages/adapter-search-memory/src/index.ts"],
      "@mind-diary/adapter-security-webcrypto": ["packages/adapter-security-webcrypto/src/index.ts"],
      "@mind-diary/adapter-audit-memory": ["packages/adapter-audit-memory/src/index.ts"],
      "@mind-diary/composition-root": ["packages/composition-root/src/index.ts"],
      "@mind-diary/test-fixtures": ["packages/test-fixtures/src/index.ts"]
    }
  }
}
