{
  "name": "mind-diary",
  "version": "0.0.0",
  "private": true,
  "description": "Mind Diary deployable OpenAI Sites MVP; owner-only UAT web, persistence, and Codex MCP gates are verified.",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "clean": "tsc -b --clean && node scripts/clean-output.mjs",
    "build": "tsc -b",
    "test:unit": "npm run build --silent && node --test tests/unit/*.test.mjs",
    "test:integration": "npm run build --silent && node --test tests/integration/*.test.mjs",
    "test:conformance": "npm run build --silent && node --test tests/conformance/*.test.mjs && npm run validate:fixtures --silent",
    "test": "npm run test:unit && npm run test:integration && npm run test:conformance",
    "validate:fixtures": "npm run build --silent && node scripts/validate-okf-fixtures.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:product-site": "node scripts/check-product-site.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "gate:synthetic-multi-principal": "npm run build --silent && node scripts/run-synthetic-multi-principal-probe.mjs",
    "gate:synthetic-browser": "npm run build --silent && node scripts/run-synthetic-browser-gate.mjs",
    "gate:oauth-direct-plugin": "npm run build --silent && node scripts/run-oauth-direct-plugin-probe.mjs",
    "gate:performance": "npm run build --silent && node scripts/benchmark-runtime-performance.mjs",
    "benchmark:local-mind-scale": "npm run build --silent && node scripts/benchmark-local-mind-scale.mjs",
    "uat:multi-principal": "node scripts/run-uat-multi-principal-probe.mjs",
    "uat:operator-directory-canary": "node scripts/run-uat-operator-directory-canary.mjs",
    "uat:provider-log-boundary": "node scripts/run-provider-request-log-boundary.mjs",
    "uat:storage-matrix": "node scripts/run-uat-storage-matrix.mjs",
    "readiness:report": "node scripts/generate-readiness-report.mjs --sha HEAD --output build/readiness-report.json",
    "check": "npm run clean && npm run build && node --test tests/unit/*.test.mjs tests/integration/*.test.mjs tests/conformance/*.test.mjs && npm run validate:fixtures && npm run check:architecture && npm run check:product-site && npm run check:docs && npm run check:secrets && node scripts/generate-readiness-report.mjs --sha HEAD --output build/readiness-report.json --local-gate-status passed"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
