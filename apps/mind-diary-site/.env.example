# Local-only placeholders. Generate independent 32-byte base64url values.
MIND_DIARY_PUBLIC_ORIGIN=https://localhost
MIND_DIARY_TOKEN_VERIFIER_KEY=
MIND_DIARY_LOCATOR_KEY=
MIND_DIARY_EXPORT_DOWNLOAD_VERIFIER_KEY=
MIND_DIARY_CSRF_KEY=
# Optional 32-byte base64url gate-only HMAC key; empty disables benchmark tags.
MIND_DIARY_PERFORMANCE_CORRELATION_KEY=
# Optional comma-separated internal principal IDs; empty means no service operator.
MIND_DIARY_SERVICE_OPERATOR_PRINCIPAL_IDS=
# Optional, independent 32-byte base64url read-only system-backup operator key.
# Keep empty until its cross-user access has been explicitly authorized.
MIND_DIARY_BACKUP_OPERATOR_KEY=
