# Local-only placeholders. Generate independent 32-byte base64url values.
MIND_DIARY_PUBLIC_ORIGIN=https://localhost
MIND_DIARY_DEPLOYMENT_CLASS=dev
MIND_DIARY_TOKEN_VERIFIER_KEY=
MIND_DIARY_LOCATOR_KEY=
MIND_DIARY_EXPORT_DOWNLOAD_VERIFIER_KEY=
MIND_DIARY_CSRF_KEY=
# Optional comma-separated internal principal IDs; empty means no service operator.
MIND_DIARY_SERVICE_OPERATOR_PRINCIPAL_IDS=
# Optional explicit posture. The restricted profile below fails closed unless
# this is exactly restricted-uat and the operator allowlist is non-empty.
MIND_DIARY_DEPLOYMENT_POSTURE=
# Fixed selector only; numeric request/env overrides are intentionally absent.
MIND_DIARY_CAPACITY_PROFILE=
# Restricted-UAT diagnostics fail closed unless the declared candidate and a
# non-secret per-configuration random nonce are bound. This is a fence, not
# deployment attestation; the API returns only their SHA-256 binding.
MIND_DIARY_RELEASE_CANDIDATE_SHA=
MIND_DIARY_CAPACITY_FENCE_NONCE=
